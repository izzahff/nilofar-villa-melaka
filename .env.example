# Leave the Supabase values empty to run in demo mode (data stays in the browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Cloudflare Turnstile site key (optional, anti-spam on the enquiry form)
VITE_TURNSTILE_SITE_KEY=
# Upload endpoint for gallery and tour images (Cloudflare Pages Function)
VITE_UPLOAD_ENDPOINT=/api/upload
# Public site URL, used in registration links sent to guests
VITE_SITE_URL=
